# NASA FIRMS Area API map key. Server-side only; never prefix with NEXT_PUBLIC_.
NASA_FIRMS_MAP_KEY=

# Verify.mn is mobile-originated SMS verification, not outbound alert delivery.
# Keep disabled until a reviewed server-side flow and credentials are ready.
VERIFY_MN_ENABLED=false
VERIFY_MN_API_KEY=

# A separate supported provider is required for real outbound SMS delivery.
OUTBOUND_SMS_ENABLED=false
